# Hey Trivi — environment variables
# Copy to .env and fill in values. Never commit .env.

# AWS region (all services)
AWS_REGION=us-east-2

# DynamoDB table name (set by CDK deploy; override for local testing)
DYNAMODB_TABLE=

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Development auth token (local mode only — never deploy to production)
DEV_TOKEN=dev-token-demo

# Simulator (apps/simulator/.env.local)
MCP_SERVER_URL=http://localhost:4787/mcp
MCP_DEV_TOKEN=dev-token-demo
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback

# Simulator host model (apps/simulator/.env.local)
# gateway (default): Vercel AI Gateway, Nova 2 Lite. Needs AI_GATEWAY_API_KEY.
# bedrock: Amazon Bedrock directly. Needs AWS credentials and Bedrock quota
#          (new accounts have 0 for every Nova model; see docs/decisions.md #16).
MODEL_PROVIDER=gateway
AI_GATEWAY_API_KEY=
GATEWAY_MODEL_ID=amazon/nova-2-lite
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Polly (us-east-2 offers only the standard engine)
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=standard

# Pack agent (AgentCore Runtime)
AGENTCORE_AGENT_ID=
AGENTCORE_AGENT_ALIAS_ID=

# Simulator mock mode — set to 1 to skip the model and Polly and use replay scripts
MOCK_MODEL=
