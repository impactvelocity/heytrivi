# Hey Trivi — environment variables
# Copy to .env and fill in values. Never commit .env.

# AWS region (all services)
AWS_REGION=us-east-2

# DynamoDB table name (set by CDK deploy; override for local testing)
DYNAMODB_TABLE=

# Cognito (MCP server). From the CDK outputs. Leave empty for local mode.
COGNITO_USER_POOL_ID=
# Comma-separated app client ids whose access tokens are accepted
COGNITO_CLIENT_IDS=
COGNITO_DOMAIN=

# Development auth token for the demo family. Locally, keep the default. On a
# deploy, set a long random value here (infra deploy) and the same value as
# MCP_DEV_TOKEN in Amplify: the deployed server then refuses dev-token-demo,
# and the simulator only hands the token to browsers unlocked with
# DEMO_UNLOCK_CODE, so the public can't change the demo family.
DEV_TOKEN=dev-token-demo

# Simulator (apps/simulator/.env.local)
MCP_SERVER_URL=http://localhost:4787/mcp
MCP_DEV_TOKEN=dev-token-demo
# Parent page sign-in (apps/simulator/.env.local). Leave empty for the local dev sign-in.
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
# The app's public URL, for OAuth redirects (defaults to the request origin)
APP_URL=
# The parent API (defaults to MCP_SERVER_URL without /mcp)
PARENT_API_URL=
# Contact shown in the privacy policy (required before Alexa+ certification)
CONTACT_EMAIL=

# Alexa+ (infra deploy only; see docs/alexa-plus.md)
# Alexa's account linking redirect URLs, comma-separated, or just the vendor id
ALEXA_REDIRECT_URIS=
ALEXA_VENDOR_ID=
# 1 = Alexa client without a secret
ALEXA_PUBLIC_CLIENT=
# The MCP server's public URL if not the function URL (custom domain)
MCP_RESOURCE_URL=

# Demo lock (apps/simulator). Set it on a public deploy: visitors get the
# scripted demo (no model, Polly, or game server), and five clicks on the
# HeyTrivi logo (or ?unlock) open a box where this code turns on live play for
# that browser. Use a long passphrase. Leave empty locally for live play.
DEMO_UNLOCK_CODE=

# Set to 1 for a public demo that can't be changed: the scripted demo only
# (no game server, model, or voice, and no unlock), /simulator goes to /demo,
# and the parent page shows a built-in demo family whose saves aren't kept.
DEMO=

# Simulator host model (apps/simulator/.env.local)
# gateway (default): Vercel AI Gateway, Nova 2 Lite. Needs AI_GATEWAY_API_KEY.
# bedrock: Amazon Bedrock directly. Needs AWS credentials and Bedrock quota
#          (new accounts have 0 for every Nova model; see docs/decisions.md #16).
MODEL_PROVIDER=gateway
AI_GATEWAY_API_KEY=
GATEWAY_MODEL_ID=amazon/nova-2-lite
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Pack helper models (gateway). Defaults: anthropic/claude-haiku-5.5 writes, anthropic/claude-sonnet-5.5 fact-checks
PACK_WRITER_MODEL_ID=
PACK_FACT_MODEL_ID=
PACK_BEDROCK_MODEL_ID=

# Polly (us-east-2 offers only the standard engine)
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=standard

# Pack agent (AgentCore Runtime)
AGENTCORE_AGENT_ID=
AGENTCORE_AGENT_ALIAS_ID=

# Simulator mock mode — set to 1 to skip the model and Polly and use replay scripts
MOCK_MODEL=
